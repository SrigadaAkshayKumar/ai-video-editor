# Copy to .env and fill in. .env is git-ignored.
ELEVENLABS_API_KEY=
PEXELS_API_KEY=
# Optional: raises Openverse rate limits (anonymous works fine for normal use)
OPENVERSE_TOKEN=
# B-roll: Pexels is used when set, otherwise Pixabay (https://pixabay.com/api/docs/)
PIXABAY_API_KEY=
# Optional: real channel stats for the youtube-metadata skill (YouTube Data API v3 key)
YOUTUBE_API_KEY=
