   "text": "What gratuity is",
   "eyebrow": "Part 01",
   "numeral": "01",
   "section": 1
  },
  {
   "start": 30.6,
   "duration": 9.4,
   "type": "checklist",
   "side": "right",
   "text": "Gratuity in one look",
   "items": [
    {
     "label": "Paid once, when you leave",
     "state": "yes"
    },
    {
     "label": "Not paid every month",
     "state": "no"
    },
    {
     "label": "Goes to your nominee",
     "state": "yes"
    }
   ]
  },
  {
   "start": 44.4,
   "duration": 7.2,
   "type": "comparison",
   "side": "right",
   "left": {
    "label": "Old law",
    "text": "Payment of Gratuity Act, 1972"
   },
   "right": {
    "label": "Now",
    "text": "Code on Social Security, 2020"
   }
  },
  {
   "start": 52.9,
   "duration": 1.6,
   "type": "keyword_chip",
   "text": "Not every company",
   "side": "left"
  },
  {
   "start": 54.6,
   "duration": 6.4,
   "type": "number_roll",
   "value": 10,
   "suffix": "+",
   "text": "employees: the general cover",
   "decimals": 0
  },
  {
   "start": 61.8,
   "duration": 3.2,
   "type": "side_note",
   "text": "Small startup? Ask HR if it applies",
   "side": "right"
  },
  {
   "start": 65.6,
   "duration": 3.1,
