   "duration": 5.6,
   "type": "big_statement",
   "text": "₹ ?",
   "eyebrow": "Worth lakhs"
  },
  {
   "start": 13.5,
   "duration": 3.7,
   "type": "keyword_chip",
   "text": "Quit a few months early, lose it",
   "side": "right"
  },
  {
   "start": 17.9,
   "duration": 3.1,
   "type": "keyword_chip",
   "text": "Who · how much · which date",
   "side": "left"
  },
  {
