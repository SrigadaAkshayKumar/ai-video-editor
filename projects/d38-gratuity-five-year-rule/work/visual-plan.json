   "text": "The formula",
   "eyebrow": "Part 02",
   "numeral": "02",
   "section": 2
  },
  {
   "start": 69.2,
   "duration": 16.3,
   "type": "flow_diagram",
   "text": "Gratuity formula",
   "items": [
